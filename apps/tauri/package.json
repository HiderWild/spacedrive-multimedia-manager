{
	"name": "@sd/tauri",
	"private": true,
	"version": "2.0.0-alpha.2",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:with-daemon": "bun ./scripts/dev-with-daemon.ts",
		"build": "vite build",
		"build:daemon": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$cargoArguments = @('build', '--bin', 'sd-daemon', '--manifest-path', '../../Cargo.toml'); if ($env:CARGO_BUILD_TARGET) { $cargoArguments += @('--target', $env:CARGO_BUILD_TARGET) }; & '../../scripts/invoke-spacedrive-cargo.ps1' @cargoArguments; exit $LASTEXITCODE\"",
		"build:daemon:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$cargoArguments = @('build', '--release', '--bin', 'sd-daemon', '--manifest-path', '../../Cargo.toml'); if ($env:CARGO_BUILD_TARGET) { $cargoArguments += @('--target', $env:CARGO_BUILD_TARGET) }; & '../../scripts/invoke-spacedrive-cargo.ps1' @cargoArguments; exit $LASTEXITCODE\"",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"tauri": "tauri",
		"tauri:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-tauri-dev.ps1",
		"tauri:dev:no-watch": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-tauri-dev.ps1 -NoWatch",
		"tauri:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-tauri-dev.ps1 -Build"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.0",
		"@sd/assets": "workspace:*",
		"@sd/interface": "workspace:*",
		"@sd/ts-client": "workspace:*",
		"@spacedrive/primitives": "^0.2.3",
		"@tauri-apps/api": "^2.1.1",
		"@tauri-apps/plugin-dialog": "^2.4.2",
		"@tauri-apps/plugin-fs": "^2.0.1",
		"@tauri-apps/plugin-shell": "^2.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "=6.20.1",
		"react-scan": "^0.4.3"
	},
	"devDependencies": {
		"@headlessui/tailwindcss": "^0.2.0",
		"@spacedrive/tokens": "^0.2.3",
		"@vitejs/plugin-react-swc": "^4.0.0",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.10",
		"@tailwindcss/vite": "^4.1.0",
		"@tauri-apps/cli": "^2.1.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"tailwindcss": "^4.1.0",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-radix": "^2.8.0",
		"typescript": "^5.6.2",
		"vite": "^5.4.9"
	}
}
